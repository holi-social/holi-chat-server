server_name: ${HOLI_CHAT_SERVER_NAME}
pid_file: /data/homeserver.pid
listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: false
    bind_addresses: ["::"]
    resources:
      - names: [client, federation]
        compress: false
database:
  name: psycopg2
  args:
    user: ${HOLI_CHAT_DB_USER}
    password: ${HOLI_CHAT_DB_PASSWORD}
    database: ${HOLI_CHAT_DB_NAME}
    host: ${HOLI_CHAT_DB_HOST}
    port: 5432
    cp_min: 5
    cp_max: 10
    cp_reconnect: true
    keepalives_idle: 10 # seconds of inactivity after which TCP should send a keepalive message to the server
    keepalives_interval: 10 # the number of seconds after which a TCP keepalive message that is not acknowledged by the server should be retransmitted    
    keepalives_count: 3 # the number of TCP keepalives that can be lost before the client's connection to the server is considered dead
oidc_providers:
  - idp_id: ory
    idp_name: "holi"
    issuer: ${ORY_BASE_URL}
    client_id: ${HOLI_CHAT_ORY_CLIENT_ID}
    client_secret: ${HOLI_CHAT_ORY_CLIENT_SECRET}
    scopes: ["openid", "profile"]
    user_mapping_provider:
      config:
        localpart_template: '{{ user.identity }}'
        display_name_template: "{{ user.name }}"
    backchannel_logout_enabled: true # Optional

enable_registration: false
enable_set_displayname: false
enable_set_avatar_url: false
enable_3pid_changes: false
password_config:
  enabled: false
log_config: "/data/holi.chat.server.log.config"
media_store_path: /data/media_store
registration_shared_secret: ${HOLI_CHAT_REGISTRATION_SHARED_SECRET}
report_stats: true
macaroon_secret_key: ${HOLI_CHAT_MACAROON_SECRET_KEY}
form_secret: ${HOLI_CHAT_FORM_SECRET}
trusted_key_servers:
  - server_name: "matrix.org"
sso:
  client_whitelist:
    - http://localhost
  update_profile_information: true

jwt_config:
  enabled: true
  secret: ${HOLI_CHAT_ORY_PUBLIC_JWT_KEYS}
  algorithm: "RS256"
  subject_claim: "ident"

rc_message:
  per_second: 2
  burst_count: 20
rc_registration:
  per_second: 2
  burst_count: 10
rc_registration_token_validity:
  per_second: 2
  burst_count: 10
rc_login:
  address:
    per_second: 2
    burst_count: 10
  account:
    per_second: 2
    burst_count: 10
  failed_attempts:
    per_second: 0.1
    burst_count: 5
ip_range_whitelist:
  ${HOLI_CHAT_IP_RANGE_WHITELIST}
