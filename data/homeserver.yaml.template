server_name: ${HOLI_CHAT_SERVER_NAME}
pid_file: /data/homeserver.pid
listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: false
    bind_addresses: ['::']
    resources:
      - names: [client, federation]
        compress: false
database:
  name: psycopg2
  txn_limit: 10000
  args:
    user: ${HOLI_CHAT_DB_USER}
    password: ${HOLI_CHAT_DB_PASSWORD}
    database: ${HOLI_CHAT_DB_NAME}
    host: ${HOLI_CHAT_DB_HOST}
    port: 5432
    cp_min: 5
    cp_max: 10
oidc_providers:
  - idp_id: ory
    idp_name: "holi"
    issuer: ${ORY_BASE_URL}
    client_id: ${HOLI_CHAT_ORY_CLIENT_ID}
    client_secret: ${HOLI_CHAT_ORY_CLIENT_SECRET}
    scopes: ["openid", "profile"]
    user_mapping_provider:
      config:
        localpart_template: '{{ user.name|lower|replace(" ", "_") }}'
        display_name_template: "{{ user.name }}"
    backchannel_logout_enabled: true # Optional

log_config: "/data/holi.chat.server.log.config"
media_store_path: /data/media_store
registration_shared_secret: ${HOLI_CHAT_REGISTRATION_SHARED_SECRET}
report_stats: true
macaroon_secret_key: ${HOLI_CHAT_MACAROON_SECRET_KEY}
form_secret: ${HOLI_CHAT_FORM_SECRET}
trusted_key_servers:
  - server_name: "matrix.org"
sso:
  client_whitelist:
    - http://localhost
  update_profile_information: true

